{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "energia-chile",
  "main": "dist/worker.js",
  "compatibility_date": "2025-12-02",
  "workers_dev": true,
  "assets": {
    "directory": "./dist/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  }
}
